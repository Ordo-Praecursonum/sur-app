<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Sur uses Face ID to securely access your wallet and protect your private keys.</string>
	<key>NSCameraUsageDescription</key>
	<string>Sur Cam uses the camera to capture photos and videos that get a proof of authorship recorded on chain.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sur uses the microphone to record video sound in Sur Cam and to record voice-memo attestations.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Sur saves the photos and videos you capture in Sur Cam to your Photos library.</string>
	<key>NSContactsUsageDescription</key>
	<string>Sur reads your contacts so you can call them from the Calls tab.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>facetime</string>
		<string>facetime-audio</string>
	</array>
	<!-- Allow plaintext HTTP to local/LAN endpoints (e.g. a local `ignite chain serve`
	     at http://localhost:1317). Remote networks (devnet/testnet/mainnet) use HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- DEV ONLY: allows cleartext HTTP to a local chain on a LAN IP
		     (e.g. http://192.168.x.x:1317) from a physical device, which
		     NSAllowsLocalNetworking alone does not permit. Remove or replace
		     with specific NSExceptionDomains before shipping. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Background processing: finish pending on-chain attestations without the
	     app being actively used (BGProcessingTask + short background window). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ordo.sur.attest.flush</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
